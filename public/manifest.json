{
  "manifest_version": 3,
  "name": "oh-my-tab",
  "version": "0.1.0",
  "description": "Chrome 新标签页与浏览器启动页个人工作台",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.bing.com/*",
    "https://suggestqueries.google.com/*",
    "https://suggestion.baidu.com/*",
    "https://s.search.bilibili.com/*"
  ],
  "action": {
    "default_title": "oh-my-tab"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
